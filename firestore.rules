rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /workspaces/agp-inventory-leads {
      allow read, write: if request.auth != null;

      match /audit/{auditId} {
        allow read, create: if request.auth != null;
        allow update, delete: if false;
      }
    }
  }
}
