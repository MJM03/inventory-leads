rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function workspaceData() {
      return get(/databases/$(database)/documents/workspaces/agp-inventory-leads).data;
    }

    function isActiveMember() {
      return signedIn()
        && ('members' in workspaceData())
        && (request.auth.uid in workspaceData().members)
        && workspaceData().members[request.auth.uid].active == true;
    }

    function hasRole(roleName) {
      return isActiveMember()
        && workspaceData().members[request.auth.uid].role == roleName;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isSupervisor() {
      return hasRole('supervisor');
    }

    function isSeller() {
      return hasRole('vendedor');
    }

    match /workspaces/agp-inventory-leads {
      allow read: if signedIn()
        && (!('members' in resource.data) || isActiveMember());

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && ('members' in request.resource.data)
        && (request.auth.uid in request.resource.data.members)
        && request.resource.data.members[request.auth.uid].role == 'admin'
        && request.resource.data.members[request.auth.uid].active == true;

      allow update: if
        isAdmin()
        || (
          signedIn()
          && !('ownerUid' in resource.data)
          && !('members' in resource.data)
          && request.resource.data.ownerUid == request.auth.uid
          && ('members' in request.resource.data)
          && (request.auth.uid in request.resource.data.members)
          && request.resource.data.members[request.auth.uid].role == 'admin'
          && request.resource.data.members[request.auth.uid].active == true
        )
        || (
          isSupervisor()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.members == resource.data.members
        )
        || (
          isSeller()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.members == resource.data.members
          && request.resource.data.state.get('inventoryLeadAssignments', {})
             == resource.data.state.get('inventoryLeadAssignments', {})
        );

      allow delete: if false;

      match /audit/{auditId} {
        allow read, create: if isActiveMember();
        allow update, delete: if false;
      }
    }
  }
}
